# Virtual environments
venv/
.venv/
env/
.env/

# Python bytecode and cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Git repository
.git/
.gitignore

# Environment secrets (loaded via docker-compose env_file at runtime)
.env
.env.*
!.env.example

# Local SQLite database (mounted via volume at runtime to preserve state)
kwi_municipal.db
*.db
*.sqlite
*.sqlite3

# Uploaded files (mounted via volume at runtime to preserve uploads)
uploads/

# Testing caches & IDE files
.pytest_cache/
.coverage
htmlcov/
.vscode/
.idea/
