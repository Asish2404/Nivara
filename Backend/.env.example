# Kolkata Water Intelligence (KWI) - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

PROJECT_NAME=Kolkata Water Intelligence
API_V1_STR=/api/v1
DEBUG=True
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# SQLite Database URL
DATABASE_URL=sqlite+aiosqlite:///./kwi_municipal.db

# Free Email SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAILS_FROM_NAME=Kolkata Municipal Corporation - KWI 2FA

# SMS Gateway Configuration (Optional: Fast2SMS / Twilio)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
